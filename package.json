{
  "name": "stockpilot-fresh",
  "version": "1.0.2",
  "description": "SellQuanta - local e-commerce operations and warehouse manager",
  "author": "SellQuanta",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/infobridgeindiaofficial-rgb/sellquanta.git"
  },
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm run server\" \"npm run client\"",
    "server": "node server/index.mjs",
    "client": "npm --prefix client run dev",
    "install:all": "npm install && npm --prefix client install",
    "desktop": "electron .",
    "desktop:build": "npm --prefix client run build && electron-builder --win nsis dir",
    "test": "node --test client/src/*.test.js tools/*.test.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.1"
  },
  "build": {
    "appId": "com.sellquanta.desktop",
    "productName": "SellQuanta",
    "copyright": "SellQuanta",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "asar": false,
    "files": [
      "package.json",
      "electron/**/*",
      "server/**/*",
      "client/dist/**/*",
      "tools/SellQuanta.ico",
      "!**/*.test.*",
      "!**/*.map"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "tools/SellQuanta.ico",
      "executableName": "SellQuanta"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SellQuanta",
      "installerIcon": "tools/SellQuanta.ico",
      "uninstallerIcon": "tools/SellQuanta.ico",
      "installerHeaderIcon": "tools/SellQuanta.ico",
      "uninstallDisplayName": "SellQuanta",
      "artifactName": "SellQuanta Setup ${version}.${ext}",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "include": "build-resources/installer.nsh"
    }
  }
}
